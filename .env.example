# Copiar a .env.local y completar. Nunca subir .env.local al repositorio.

# Supabase (Project Settings > API). La publicable puede ir al navegador; la secreta, nunca.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# URL pública del sitio (se usa en los enlaces de los correos y del callback de auth).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Correos con Resend. Sin RESEND_API_KEY los correos se omiten sin error.
RESEND_API_KEY=
EMAIL_FROM="Agenda Salud <avisos@tu-dominio.cl>"

# Secreto del cron de recordatorios (mínimo 16 caracteres, por ejemplo: openssl rand -hex 32).
CRON_SECRET=

# Desarrollo local con `npx supabase start`: usar la URL http://127.0.0.1:54321 y las claves que imprime la CLI.
