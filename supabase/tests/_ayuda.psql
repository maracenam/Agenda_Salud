-- Ayudas para las pruebas unitarias de base de datos (pgTAP). Se incluye con \ir.
-- Cada archivo de prueba corre en una transacción que se revierte al final.
create or replace function pg_temp.usuario(p_email text, p_meta jsonb) returns uuid
language sql as $$
  insert into auth.users (instance_id, id, aud, role, email, raw_user_meta_data, email_confirmed_at, created_at, updated_at)
  values ('00000000-0000-0000-0000-000000000000', gen_random_uuid(), 'authenticated', 'authenticated', p_email, p_meta, now(), now(), now())
  returning id;
$$;

-- Actuar como un usuario autenticado (auth.uid() = p_id)
create or replace function pg_temp.como(p_id uuid) returns void
language plpgsql as $$
begin
  perform set_config('request.jwt.claims', json_build_object('sub', p_id, 'role', 'authenticated')::text, true);
  perform set_config('role', 'authenticated', true);
end;
$$;

create or replace function pg_temp.como_anon() returns void
language plpgsql as $$
begin
  perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
  perform set_config('role', 'anon', true);
end;
$$;

create or replace function pg_temp.como_admin() returns void
language plpgsql as $$
begin
  perform set_config('request.jwt.claims', '', true);
  perform set_config('role', 'postgres', true);
end;
$$;

-- Próximo lunes (hora de Chile), al menos 7 días adelante, a la hora indicada
create or replace function pg_temp.lunes(p_hora time) returns timestamptz
language sql as $$
  select ((date_trunc('week', (now() at time zone 'America/Santiago'))::date + 7 + p_hora)::timestamp at time zone 'America/Santiago');
$$;

-- Profesional publicada con una prestación de 30 min y horario los lunes de 9 a 13
create or replace function pg_temp.profesional_lista(p_email text, p_especialidad text default 'matroneria') returns uuid
language plpgsql as $$
declare v uuid;
begin
  v := pg_temp.usuario(p_email, jsonb_build_object('rol', 'profesional', 'nombre', 'Pro ' || p_email, 'especialidad', p_especialidad));
  insert into public.servicios (profesional_id, nombre, duracion_min, precio) values (v, 'Consulta', 30, 20000);
  insert into public.horarios (profesional_id, dia_semana, hora_inicio, hora_fin) values (v, 1, '09:00', '13:00');
  update public.profesionales set publicado = true where id = v;
  return v;
end;
$$;

create or replace function pg_temp.servicio_de(p_pro uuid) returns uuid
language sql as $$ select id from public.servicios where profesional_id = p_pro limit 1 $$;
